<?xml version="1.0" encoding="utf-8"?>
<!--
  Aurora ERP - NuGet configuration.

  One source, mapped explicitly. Every package version lives in Directory.Packages.props and
  every restored package must appear in docs/architecture/dependencies.md, which scripts/verify.sh
  stage 4 enforces (docs/architecture/solution-layout.md 5.2).
-->
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <disabledPackageSources>
    <clear />
  </disabledPackageSources>

  <!-- A package may only ever come from nuget.org. Explicit mapping makes adding a second
       source a reviewable edit in this file rather than something a machine-local
       NuGet.config can slip in unnoticed. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>

</configuration>
