  "motion": {
    "duration-instant": "80ms",
    "duration-fast": "120ms",
    "duration-base": "180ms",
    "duration-slow": "240ms",
    "duration-slower": "320ms",
    "easing-standard": "cubic-bezier(0.2, 0, 0, 1)",
